@{
    ViewData["Title"] = "Write Log";
}

<h2>Write a Log Entry</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Log Message</label>
        <textarea name="logMessage" class="form-control" rows="4" required></textarea>
    </div>

    <button type="submit" class="btn btn-success">Save Log</button>
</form>

<br />
<a asp-action="Index" class="btn btn-secondary">View Existing Logs</a>