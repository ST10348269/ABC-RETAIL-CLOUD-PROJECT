@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold mb-3" style="color:#0f172a;">
        Welcome to ABC Retail
    </h1>
    <p class="lead text-muted mb-4" style="max-width: 600px; margin: 0 auto;">
        Your modern cloud-powered retail platform.
        Manage customers, products, orders and logs : all running on Microsoft Azure.
    </p>

    <div class="row justify-content-center mt-5 g-4">
        <div class="col-md-3">
            <div class="card p-4 h-100">
                <h5 class="fw-semibold">Customers</h5>
                <p class="text-muted small mb-0">Store and manage customer profiles using Azure Tables</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-4 h-100">
                <h5 class="fw-semibold">Products</h5>
                <p class="text-muted small mb-0">Product catalog with images hosted on Azure Blob Storage</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-4 h-100">
                <h5 class="fw-semibold">Orders</h5>
                <p class="text-muted small mb-0">Reliable order processing powered by Azure Queues</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-4 h-100">
                <h5 class="fw-semibold">Logs</h5>
                <p class="text-muted small mb-0">Application logs securely stored in Azure Files</p>
            </div>
        </div>
    </div>

    <p class="mt-5 text-muted">
        Use the menu above to explore the different sections of the system.
    </p>
</div>