@model List<string>

@{
    ViewData["Title"] = "Order Queue";
}

<h2>Messages in Azure Queue</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Place New Order</a>
</p>

@if (Model != null && Model.Any())
{
    <ul class="list-group">
        @foreach (var msg in Model)
        {
            <li class="list-group-item">@msg</li>
        }
    </ul>
}
else
{
    <p class="text-muted">No messages in the queue yet.</p>
}